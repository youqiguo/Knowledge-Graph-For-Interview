{
  "name": "knowledge-graph-interview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch --watch-path=./server --watch-path=./.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cytoscape": "^3.30.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.49.0",
    "vite": "^6.0.7"
  }
}
